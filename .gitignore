.aider*
.env
.testmondata

# Embedded repos with their own .git (not true submodules, no .gitmodules) -
# tracked independently on disk, deliberately excluded from this superproject's index.
/apps/batch_factory/

# apps/evaluator/ の物理統合(instructions/006)に伴うローカル退避先。旧.git履歴(749MB)・
# serviceAccountKey.json等を含むため、親リポジトリのトラッキング対象には絶対に含めない。
/apps/evaluator_backup/

# --- Git運用ガードレール(誤コミット事故防止) ---

# 仮想環境
.venv/
.venv_ai/
.venv_train/

# SQLite本体およびWAL/SHMサイドカーファイル
*.db
*.db-wal
*.db-shm
*-wal
*-shm

# Nazo-Agentの出力物(デッドレター・監査ログ等、再生成可能な成果物)
tools/audit_reports/

# ベンチマークハーネスの生成物(メトリクスJSON等、再生成可能な成果物)
tools/benchmark/reports/

# VRAMグローバル排他ロック(ランタイムのみ存在するファイルロック本体)
.vram.lock

# tools/run_migrations.pyのマイグレーション排他ロック(ランタイムのみ存在するファイルロック本体)
*.migration.lock

# mlops_trigger.pyの「前回トリガー時点の件数」永続化状態(再生成可能)
tools/mlops_trigger_state.json

# mlops_trigger.pyの直前サイクルの判定結果(instructions/169、再生成可能)
tools/mlops_trigger_last_run.json
tools/mlops_trigger_last_run.tmp.json

# scheduler_daemon.pyの最終実行時刻・終了コード(instructions/161、再生成可能)
tools/scheduler_daemon_state.json

# safe_reset_infra.pyの一時バックアップ(異常終了時の残骸を誤コミットしないためのガード)
data/db_backup_temp.json

# extract_dataset.pyが生成するSFT/DPOデータセットおよび抽出統計(再生成可能な成果物)
data/sft_dataset.jsonl
data/dpo_dataset.jsonl
data/extraction_stats.json

# 一時ファイル・スモークテストの残骸
_tmp*

# 標準的な除外対象
__pycache__/
*.pyc
*.log

# パッケージビルド生成物
*.egg-info/

# 巨大な全コードダンプファイル
# Post-mortem(100): pre-commitの一時退避(スタッシュ)が100MB規模のパッチを生成し
# ハングアップした際の原因ファイルとして特定済み(実測89MB、Git監視下の唯一の巨大な
# 未追跡ファイル)。以後の再追跡・再発を防ぐため、この行を明示的な根拠として維持する。
all_source_code.txt

# tools/deploy/run_ephemeral_pipeline.ps1(instructions/177)がgit archiveで都度
# 再生成する、エフェメラルVM転送用のHEADスナップショット(再生成可能な成果物)。
# 【instructions/187】tools/deploy/run_verification_server.ps1(instructions/164)は
# ZIP圧縮+scp転送方式そのものがSRE監査でRejectされ、閉域GitOps(git push)方式の
# tools/deploy/deploy_to_vm.ps1へ置き換えられた(source.zipを生成しない)。
source.zip
all_source_code.txt
**/all_source_code.txt
