.aider*
.env
.testmondata

# Embedded repos with their own .git (not true submodules, no .gitmodules) -
# tracked independently on disk, deliberately excluded from this superproject's index.

# apps/evaluator/ の物理統合(instructions/006)に伴うローカル退避先。旧.git履歴(749MB)・
# serviceAccountKey.json等を含むため、親リポジトリのトラッキング対象には絶対に含めない。
/apps/evaluator_backup/

# --- Git運用ガードレール(誤コミット事故防止) ---

# 仮想環境
.venv/
.venv_ai/
.venv_train/

# SQLite本体およびWAL/SHMサイドカーファイル
*.db
*.db-wal
*.db-shm
*-wal
*-shm
# バックフィル等のマイグレーション前に取得する手動バックアップ(*.db.bak)
*.db.bak

# 【instructions/265: tools/自己保護とステート分離】tools/をインフラ層でRead-Only化する
# ため、エージェント関連ツール群の一時ファイル・ログ・状態ファイルはすべて run/ 配下へ
# 出力する(tools/配下ではない)。以下、run/配下の再生成可能な成果物をまとめて除外する。

# Nazo-Agentの出力物(デッドレター・監査ログ等、再生成可能な成果物)
run/audit_reports/

# ベンチマークハーネスの生成物(メトリクスJSON等、再生成可能な成果物)
run/benchmark/reports/

# VRAMグローバル排他ロック(ランタイムのみ存在するファイルロック本体)
.vram.lock

# tools/run_migrations.pyのマイグレーション排他ロック(ランタイムのみ存在するファイルロック本体)
*.migration.lock

# mlops_trigger.pyの「前回トリガー時点の件数」永続化状態(再生成可能)
run/mlops_trigger_state.json

# mlops_trigger.pyの直前サイクルの判定結果(instructions/169、再生成可能)
run/mlops_trigger_last_run.json
run/mlops_trigger_last_run.tmp.json

# scheduler_daemon.pyの最終実行時刻・終了コード(instructions/161、再生成可能)
run/scheduler_daemon_state.json

# preflight_check.py/context_manager.pyのタスク状態・エージェント長期記憶(再生成可能)
run/tasks_state.json
run/tasks_state.json.lock
run/context_state.json
run/context_state.json.lock

# shadow_mode.pyの検証用ログ(再生成可能)
run/shadow_mode_log.jsonl
run/shadow_mode_log.jsonl.lock
run/shadow_mode_log.tmp.jsonl

# compile_knowledge.pyのビルド成果物(tools/instructions/から再生成可能)
run/ai_knowledge_base.json

# extract_agent_sft.pyが抽出する自己修復トレース(再生成可能、実行ログ由来のため非コミット)
run/dataset/

# mlops_experiments_db.py(*.dbパターンで既にカバーされるが明示しておく)
run/mlops_experiments.db

# safe_reset_infra.pyの一時バックアップ(異常終了時の残骸を誤コミットしないためのガード)
data/db_backup_temp.json

# extract_dataset.pyが生成するSFT/DPOデータセットおよび抽出統計(再生成可能な成果物)
data/sft_dataset.jsonl
data/dpo_dataset.jsonl
data/extraction_stats.json

# extract_training_data.pyが生成するインストラクション・チューニング用JSONL
# (instructions/241、再生成可能な成果物かつ実ユーザーデータを含むため非コミット)
data/training/

# 一時ファイル・スモークテストの残骸
_tmp*

# 標準的な除外対象
__pycache__/
*.pyc
*.log

# パッケージビルド生成物
*.egg-info/

# 巨大な全コードダンプファイル
# Post-mortem(100): pre-commitの一時退避(スタッシュ)が100MB規模のパッチを生成し
# ハングアップした際の原因ファイルとして特定済み(実測89MB、Git監視下の唯一の巨大な
# 未追跡ファイル)。以後の再追跡・再発を防ぐため、この行を明示的な根拠として維持する。
all_source_code.txt

# tools/deploy/run_ephemeral_pipeline.ps1(instructions/177)がgit archiveで都度
# 再生成する、エフェメラルVM転送用のHEADスナップショット(再生成可能な成果物)。
# 【instructions/187】tools/deploy/run_verification_server.ps1(instructions/164)は
# ZIP圧縮+scp転送方式そのものがSRE監査でRejectされ、閉域GitOps(git push)方式の
# tools/deploy/deploy_to_vm.ps1へ置き換えられた(source.zipを生成しない)。
source.zip
all_source_code.txt
**/all_source_code.txt

# 使い捨ての調査・修復スクリプトおよびログ（機械学習リファレンス用）
tools/apply_*.py
tools/diagnose_*.py
tools/dump_*.py
tools/investigate_*.py
tools/verify_*.py
tools/audit_reports/
tools/instructions/

# apps/evaluator_backup(→archive/_trash_candidates/apps_evaluator_backup/へ移動、フェーズ2)は
# 独自の.gitを持つ埋め込みリポジトリで、かつ移動前も一度もgit管理下に無かった死んだコード
# (.claudeignoreで既に「デッドコード、どこからも参照されない」と確認済み)。.gitmodules
# を持たないorphan gitlinkとして誤ってコミットすると、clone時に中身が復元できない
# ダングリング参照が永続的に残るだけで無意味なため、意図的にgit管理対象から除外する。
archive/_trash_candidates/apps_evaluator_backup/

data/sqlite/*.zip
