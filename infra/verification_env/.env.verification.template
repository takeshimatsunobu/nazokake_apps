# infra/verification_env/.env.verification.template
# =====================================================
# 検証サーバー上の .env テンプレート。setup_verification_env.sh が
# __REPO_DIR__ を実際のクローン先絶対パスへ置換して <REPO_DIR>/.env として配置する。
#
# 【設計方針】tools/config.py(ToolsSettings)がそのまま読み込む前提の変数名にする。
# アプリ本体・MLOpsパイプライン・このベンチマーク検証がcwdの違いに関わらず同一の
# DBファイル/VRAMロックファイルを指すよう、すべて絶対パスで固定する(run_api.ps1が
# $env:NAZOKAKE_DB_PATH/$env:VRAM_LOCK_PATHを絶対パス固定している既存パターンと同じ)。

# nazokake_core.database の接続先(sqlite)。相対パスのまま複数プロセスから異なるcwdで
# 起動すると別々のDBファイルを指してしまうため、検証サーバー上では必ず絶対パスにする。
#
# 【instructions/162】永続層(データベース)を data/ ディレクトリへ分離した。
# mlops-schedulerサイドカー(infra/verification_env/docker-compose.yml)がリポジトリ
# 全体ではなくこの data/ ディレクトリのみを局所マウントできるようにするための配置
# であり、揮発層(VRAM_LOCK_PATH、下記)とは関心の分離のため明確に別ディレクトリへ
# 隔離する(同一ディレクトリに混在させると、片方の局所マウント範囲がもう片方の
# ライフサイクル・所有権と衝突し、デッドロックの温床になるため)。
NAZOKAKE_DB_PATH=__REPO_DIR__/data/nazokake_local.db

# tools/config.py:VRAM_LOCK_PATH と同じ絶対パス規約。アプリ本体・MLOpsパイプライン
# (tools/mlops_pipeline_nazo.py/agent.py)・このベンチマーク検証(run_benchmark.py)の
# 全プロセスが同一のロックファイルを取得することで、Rootless Docker上のGPU単一専有
# (docker run --gpus device=0)と組み合わせてVRAM競合を直列化する。
#
# 【instructions/162】揮発層(ランタイムのみ存在するファイルロック本体)を data/ とは
# 独立した run/ ディレクトリへ隔離した。永続的なデータベースと同じディレクトリ・
# 同じマウントを共有させないことで、mlops-schedulerサイドカーがdata/とrun/を
# それぞれ独立した最小特権のボリュームとして個別にマウントできるようにする。
VRAM_LOCK_PATH=__REPO_DIR__/run/.vram.lock

# Ollamaクライアントの接続先。検証サーバー上でOllamaが127.0.0.1以外にbindされている
# 場合はここを上書きする(0.0.0.0等のbind用アドレスはtools/config.pyがFail-Fastで拒否する)。
OLLAMA_HOST=http://127.0.0.1:11434

# 異常終了時・定量評価ゲート不合格時にDiscord/Slack等へ通知するWebhook URL(任意)。
# 未設定の場合、tools/mlops_common.py.send_alert_webhook()は何もせず即returnする。
# ALERT_WEBHOOK_URL=

# 6次元定量評価ゲートの閾値(既定値をそのまま使う場合は設定不要。運用中の調整用)。
# QUALITY_GATE_TIME_TO_QUALITY_PARITY_MAX=3.0
